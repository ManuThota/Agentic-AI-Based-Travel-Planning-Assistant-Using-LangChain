# Vagabond AI - Environment Configuration (Groq Only)

# Place your Groq API key below. Obtain one from console.groq.com.
GROQ_API_KEY=your_groq_api_key_here

# Amadeus API Configuration (Optional: falls back to local databases if not set)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here